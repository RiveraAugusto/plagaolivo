# ============================================================
# OLIVOSCAN - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copie este archivo como .env.local y configure sus credenciales
# ============================================================

# Supabase (Obligatorio para Autenticación y Base de Datos)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase

# Cloudinary (Almacenamiento de imágenes de hojas capturadas)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_UPLOAD_PRESET=tu-upload-preset

# Google Gemini API (Diagnóstico de plagas y recomendaciones)
GEMINI_API_KEY=tu-gemini-api-key
